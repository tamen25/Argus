// Argus bench condition: remediated.
//
// The telemetry with Argus's own fix applied: the missing-resource-attributes
// patch, exactly as `argus remediate` renders it for ARG-RES-002/003 (which fire
// on 17 and 18 of 18 services on the dev cluster), with its one placeholder
// filled in. Nothing is degraded. A test holds this file to the template, so
// the experiment measures what Argus actually generates.
//
// entry: otelcol.processor.k8sattributes.argus_k8s_condition
// --- rendered by argus remediate ---
// Argus remediation: missing-resource-attributes — ARG-RES-002 on "condition"
// Generated by `argus remediate` — review before applying.
//
// PREFERRED FIX (do this instead if you own the workload): set the identity
// attributes in the SDK, e.g.
//   OTEL_RESOURCE_ATTRIBUTES=service.version=<version>,deployment.environment.name=<env>
// The patch below fills them in at the collector for everything it receives:
//   - Kubernetes identity (namespace, deployment/statefulset/daemonset, pod,
//     node), so telemetry names the workload it came from;
//   - service.version from the pod label app.kubernetes.io/version, where the
//     workload sets it;
//   - deployment.environment.name, where the telemetry has none.
//
// The k8sattributes processor needs read access (get, list, watch) to pods,
// namespaces and replicasets. It matches telemetry to pods by the sending
// connection's IP, so it belongs on a collector that receives directly from
// the workloads, not behind another gateway.

otelcol.processor.k8sattributes "argus_k8s_condition" {
  extract {
    metadata = [
      "k8s.namespace.name",
      "k8s.deployment.name",
      "k8s.statefulset.name",
      "k8s.daemonset.name",
      "k8s.pod.name",
      "k8s.node.name",
    ]
    label {
      from     = "pod"
      key      = "app.kubernetes.io/version"
      tag_name = "service.version"
    }
  }

  output {
    metrics = [otelcol.processor.transform.argus_environment_condition.input]
    logs    = [otelcol.processor.transform.argus_environment_condition.input]
    traces  = [otelcol.processor.transform.argus_environment_condition.input]
  }
}

otelcol.processor.transform "argus_environment_condition" {
  error_mode = "ignore"

  trace_statements {
    context    = "resource"
    statements = [
      `set(attributes["deployment.environment.name"], "kind-dev") where attributes["deployment.environment.name"] == nil`,
    ]
  }
  metric_statements {
    context    = "resource"
    statements = [
      `set(attributes["deployment.environment.name"], "kind-dev") where attributes["deployment.environment.name"] == nil`,
    ]
  }
  log_statements {
    context    = "resource"
    statements = [
      `set(attributes["deployment.environment.name"], "kind-dev") where attributes["deployment.environment.name"] == nil`,
    ]
  }

  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}
