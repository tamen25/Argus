# Argus remediation: unit-in-metric-name — {{.RuleID}} on {{q .Service}}
# Generated by `argus remediate` — review before applying.
# Scoped to this service: on a shared collector, other services emitting the
# same metric are left alone.
#
# PREFERRED FIX (do this instead if you own the workload): name the instrument
# without the unit (http.server.request.duration, not ...duration.seconds) and
# pass the unit separately.
#
# CAUTION: renaming a metric breaks every dashboard, alert and recording rule
# that queries the old name. Update those in the same change, or keep both
# names during a migration window.
#
# The patch below renames one metric and records its unit. Fill in both
# placeholders.

processors:
  transform/argus_metric_rename_{{.SafeService}}:
    error_mode: ignore
    metric_statements:
      - context: metric
        statements:
          - set(unit, "REPLACE_WITH_UCUM_UNIT") where name == "{{.Metric}}" and resource.attributes["service.name"] == "{{.ScopeService}}" and unit == ""
          - set(name, "REPLACE_WITH_NAME_WITHOUT_UNIT") where name == "{{.Metric}}" and resource.attributes["service.name"] == "{{.ScopeService}}"

