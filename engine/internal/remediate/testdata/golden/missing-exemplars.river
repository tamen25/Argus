// Argus remediation: missing-exemplars — ARG-MET-001 on "checkout"
// Generated by `argus remediate` — review before applying.
//
// HONEST NOTE: a collector cannot create exemplars. They are recorded by the
// SDK when a measurement is taken inside a sampled span. The real fix is in
// the application:
//   OTEL_METRICS_EXEMPLAR_FILTER=trace_based
// (the default in current SDKs; check that it has not been set to always_off),
// and the histogram must be recorded while a span is active.
//
// What the pipeline must do is not drop them. With Alloy writing to Mimir,
// make sure the remote-write endpoint sends exemplars, and that Mimir accepts
// them (its max_global_exemplars_per_user limit is 0, disabled, by default).

prometheus.remote_write "REPLACE_WITH_YOUR_REMOTE_WRITE" {
  endpoint {
    url            = "REPLACE_WITH_REMOTE_WRITE_URL"
    send_exemplars = true
  }
}
