// Argus remediation: log-severity-unset — LOG-002 on "product-reviews"
// 100% of observed log records carried no severity.
// Generated by `argus remediate` — review before applying.
//
// PREFERRED FIX (do this instead if you own the workload): log through the OTel
// logging bridge for your runtime, which maps the logger's level to severity.
//
// The patch below is a heuristic stopgap: for records with no severity, it
// infers one from a level word in the body. Check it against a sample of the
// service's logs before relying on it; a body that merely mentions "error"
// will be marked as one.

otelcol.processor.transform "argus_infer_severity_product_reviews" {
  error_mode = "ignore"

  log_statements {
    context    = "log"
    statements = [
      `set(severity_number, SEVERITY_NUMBER_ERROR) where severity_number == SEVERITY_NUMBER_UNSPECIFIED and IsMatch(body, "(?i)\\b(error|fatal|panic)\\b")`,
      `set(severity_number, SEVERITY_NUMBER_WARN) where severity_number == SEVERITY_NUMBER_UNSPECIFIED and IsMatch(body, "(?i)\\bwarn(ing)?\\b")`,
      `set(severity_number, SEVERITY_NUMBER_DEBUG) where severity_number == SEVERITY_NUMBER_UNSPECIFIED and IsMatch(body, "(?i)\\bdebug\\b")`,
      `set(severity_number, SEVERITY_NUMBER_INFO) where severity_number == SEVERITY_NUMBER_UNSPECIFIED`,
    ]
  }

  output {
    logs = [otelcol.processor.batch.default.input]
  }
}
